# PostgreSQL への接続先。
# Mac からの開発は kabu_dev、ラズパイのバッチは kabu_app を使う。
#   Mac    : postgresql+psycopg://kabu_dev:PASSWORD@raspberrypi.local:5432/kabu
#   ラズパイ: postgresql+psycopg://kabu_app:PASSWORD@localhost:5432/kabu
DATABASE_URL=postgresql+psycopg://kabu_dev:PASSWORD@localhost:5432/kabu

# 生データの置き場。実行環境で違うのでコードに埋めない。
#   Mac (デバッグ): ./.data
#   ラズパイ       : /mnt/usb/data
# kabu-terminal/data は SMB の読み取り専用マウントなのでここには指定しない。
KABU_DATA_DIR=./.data

# EDINET API のサブスクリプションキー。
# https://api.edinet-fsa.go.jp/ で登録して発行する。無いと fetch edinet が動かない。
EDINET_API_KEY=
